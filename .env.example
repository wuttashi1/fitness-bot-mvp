# Create the bot with @BotFather. Never commit the real token.
BOT_TOKEN=
# Required: YOUR numeric Telegram ID. /id works before profile registration.
OWNER_TELEGRAM_ID=
# Optional public author name; defaults to your Telegram name on first /start.
OWNER_DISPLAY_NAME=
DATABASE_PATH=./var/fitness.sqlite3
DEFAULT_TIMEZONE=Europe/Berlin
CHECKIN_HOUR=10
POLL_INTERVAL_SECONDS=5

